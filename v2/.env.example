# LLM API Settings (Groq / OpenAI compatible)
LLM_API_KEY_1=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1/chat/completions

ANSWER_MODEL=openai/gpt-oss-20b
SQL_MODEL=openai/gpt-oss-20b
FAST_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.1

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=fhir_db_new

# Pipeline Settings
SQL_ROW_LIMIT=20
SCHEMA_RETRIEVAL_K=3
MAX_SQL_RETRIES=3

# Logging & Debugging
DEBUG_MODE=True
LOG_LEVEL=INFO
