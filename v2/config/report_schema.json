    {
      "id": "demographics_3",
      "title": "Demographics",
      "anchor": "patient",
      "alias": "p",
      "joins": [],
      "select": [
        {
          "column": "p.r_firstname",
          "alias": "r_firstname"
        },
        {
          "column": "p.r_middlename",
          "alias": "r_middlename"
        },
        {
          "column": "p.r_thirdname",
          "alias": "r_thirdname"
        },
        {
          "column": "p.r_familyname",
          "alias": "r_familyname"
        },
        {
          "column": "p.nokfirstname",
          "alias": "nokfirstname"
        },
        {
          "column": "p.nokmiddlename",
          "alias": "nokmiddlename"
        },
        {
          "column": "p.noklastname",
          "alias": "noklastname"
        },
        {
          "column": "p.nokfamilyname",
